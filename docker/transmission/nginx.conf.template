upstream transmission {
    server ${TRANSMISSION_UPSTREAM};
    keepalive 4;
}

server {
    listen 80;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_header X-Transmission-Session-Id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $host;

        proxy_pass http://transmission/transmission/web/;

        # Preserve the existing web UI's relative RPC and upload URLs.
        location /rpc {
            proxy_pass http://transmission/transmission/rpc;
        }

        location /upload {
            proxy_pass http://transmission/transmission/upload;
        }
    }
}

# wcpan.drive revision to build: a branch, tag or full commit hash.
DRIVE_REF=master

# Host to bind on the Docker host.
DRIVE_HOST=0.0.0.0
# Port to bind on the Docker host; keep it apart from the stable drive project.
DRIVE_PORT=8081

# Path to the YAML config file.
DRIVE_CONFIG_FILE=/docker/config/drive-alpha.yaml
# Directory for the SQLite database; do not share it with the stable project.
DRIVE_DATA_PATH=/docker/data-alpha
# Directory to watch (add more volume entries in compose.yaml as needed).
DRIVE_WATCH_PATH=/volume1

# Bind address on the NAS; use its LAN IP to limit the listening interface.
HAH_HOST=0.0.0.0
# Match the port registered for your H@H client. Forward this TCP port to the NAS.
HAH_PORT=8080

# Absolute paths on the machine running Podman. Create these before starting.
HAH_JAR_PATH=/volume1/containers/hah/HaH.jar
HAH_STORAGE_PATH=/volume1/containers/hah/storage
